# compliance-rag environment. Copy to .env (make bootstrap does it). Defaults are offline:
# no API keys are needed for tests, the demo or `make verify`. Never commit real secrets.

# ---- shared portfolio variables
DEMO_MODE=offline                 # offline (FakeLLM, cassettes) | live (real providers)
LIVE_EVAL_BUDGET_USD=2            # make eval-live stops at this spend
ANTHROPIC_API_KEY=                # only for DEMO_MODE=live / make eval-live
OPENAI_API_KEY=                   # optional OpenAIEmbedder
AWS_REGION=us-east-1              # Bedrock (Titan, Cohere Rerank, Claude on Bedrock)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:8693
OTEL_EXPORTER_OTLP_ENDPOINT=      # e.g. http://localhost:8681 with the observability profile
LOG_LEVEL=INFO

# ---- infrastructure (host ports 8600-8699)
CRAG_DATABASE_URL=postgresql://crag:crag@localhost:8620/crag
CRAG_REDIS_URL=redis://localhost:8630/0
CRAG_OPENSEARCH_URL=http://localhost:8640
CRAG_OPENSEARCH_INDEX=crag-chunks-v1
CRAG_OPENSEARCH_ALIAS=crag-chunks
CRAG_S3_ENDPOINT_URL=http://localhost:8641
CRAG_S3_ACCESS_KEY=crag-dev-access
CRAG_S3_SECRET_KEY=crag-dev-secret-key
CRAG_S3_BUCKET=crag-raw
CRAG_S3_REGION=us-east-1
CRAG_QDRANT_URL=http://localhost:8643
CRAG_QDRANT_COLLECTION=crag_chunks

# ---- retrieval and models
CRAG_VECTOR_STORE=pgvector        # pgvector | qdrant
CRAG_EMBEDDER=lsa                 # lsa | titan | openai (Titan at 512 dims needs CRAG_EMBED_DIM=512 + make reindex)
CRAG_EMBED_DIM=384
CRAG_RERANKER=feature             # feature | cohere | cross_encoder
CRAG_LLM_PROVIDER=fake            # fake | anthropic | bedrock
CRAG_MODEL_FAST=claude-haiku-5-5
CRAG_MODEL_GENERATE=claude-opus-5-5
CRAG_MODEL_JUDGE=claude-haiku-5-5
CRAG_MODEL_TITAN_EMBED=amazon.titan-embed-text-v2:0
CRAG_MODEL_COHERE_RERANK=cohere.rerank-v3-5:0
CRAG_MODEL_OPENAI_EMBED=text-embedding-3-small
CRAG_ABSTAIN_TAU=0.35
CRAG_RRF_K=60
CRAG_TOPK_CONTEXT=8
CRAG_LEG_K=50
CRAG_LEG_TIMEOUT_MS=250
CRAG_GENERATE_TIMEOUT_S=30
CRAG_CASSETTE_DIR=tests/fixtures/llm
CRAG_RECORD_CASSETTES=false

# ---- auth and limits
CRAG_OIDC_ISSUER=http://localhost:8612
CRAG_OIDC_PUBLIC_ISSUER=
CRAG_OIDC_AUDIENCE=compliance-rag
CRAG_MAX_UPLOAD_MB=20
CRAG_MAX_QUESTION_CHARS=2000
CRAG_RATE_LIMIT_PER_MIN=30
CRAG_SSE_TTL_S=300

# ---- paths
CRAG_APP_ROOT=.
